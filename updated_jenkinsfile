pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "2asaby/final_project:from_jenkins"
        DOCKER_REPO = "2asaby/final_project"
        DOCKER_CREDENTIALS_ID = "dockerhub-mylab"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out the source code...'
                checkout scm
            }
        }

        stage('Pull Previous Image (Enable Cache)') {
            steps {
                echo 'Trying to pull previous Docker image to enable cache...'
                script {
                    // Don't fail if image doesn't exist yet
                    try {
                        docker.image("${DOCKER_IMAGE}").pull()
                    } catch (e) {
                        echo "No previous image found to cache from — continuing."
                    }
                }
            }
        }

        stage('Build Docker Image with Cache') {
            steps {
                echo 'Building the Docker image with cache enabled...'
                script {
                    docker.build("${DOCKER_IMAGE}", "--cache-from=${DOCKER_IMAGE} .")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                echo 'Pushing Docker image to Docker Hub...'
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_CREDENTIALS_ID}") {
                        docker.image("${DOCKER_IMAGE}").push()
                    }
                }
            }
        }

        stage('Deploy Application') {
            steps {
                echo 'Deploying the application...'
                script {
                    sh '''
                    docker stop final_project || true
                    docker rm final_project || true
                    docker run -d --name final_project -p 8080:8080 ${DOCKER_IMAGE}
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
